JWT_SECRET=
PORT=3005
DB_NAME=aula_formosa
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_DIALECT=mysql

# Origen permitido por CORS (la URL donde corre el frontend con `npm run dev`)
CLIENT_ORIGIN=http://localhost:5173

# Opcional: si lo completás, cada publicación nueva se manda a este webhook
# de n8n para que la IA la adapte. Si lo dejás vacío, se usa una adaptación
# local automática (no rompe nada).
N8N_WEBHOOK_URL=
